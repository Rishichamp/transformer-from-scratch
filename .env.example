# Architecture knobs -- change POS_ENCODING to compare schemes
POS_ENCODING=rope
ACTIVATION=gelu
D_MODEL=128
N_HEADS=4
N_LAYERS=4
MAX_SEQ_LEN=256
DROPOUT=0.1

# Training
DATA_PATH=./data/sample_corpus.txt
CHECKPOINT_DIR=./checkpoints
CHECKPOINT_NAME=model.pt
BATCH_SIZE=32
LEARNING_RATE=3e-4
NUM_EPOCHS=5

APP_PORT=8000
APP_HOST=0.0.0.0
